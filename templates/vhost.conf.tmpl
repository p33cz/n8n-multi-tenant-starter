# Apache vhost pro n8n-${CLIENT}. Vystavuje ven POUZE n8n editor (port ${N8N_PORT}
# na loopbacku). claude-${CLIENT} nemá žádný veřejný port.
# certbot --apache z tohoto vhostu vygeneruje :443 variantu (le-ssl.conf).
# Redirect na HTTPS řešíme sami podmínkou "HTTPS off" — je tak bezpečný i po
# zkopírování do :443 vhostu (tam je HTTPS on → redirect se nespustí, žádná smyčka).
<VirtualHost *:80>
    ServerName ${SUBDOMAIN}

    RewriteEngine On

    # 1) HTTP → HTTPS (na :80 se spustí; na :443 je HTTPS on, takže ne)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=permanent,L]

    # 2) proxy na n8n (reálně se uplatní až na :443 vhostu)
    ProxyPreserveHost On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule ^/?(.*) ws://127.0.0.1:${N8N_PORT}/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} !=websocket [NC]
    RewriteRule ^/?(.*) http://127.0.0.1:${N8N_PORT}/$1 [P,L]
    ProxyPassReverse / http://127.0.0.1:${N8N_PORT}/

    ErrorLog  ${APACHE_LOG_DIR}/${CLIENT}_error.log
    CustomLog ${APACHE_LOG_DIR}/${CLIENT}_access.log combined
</VirtualHost>
